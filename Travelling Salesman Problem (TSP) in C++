#include <iostream>
using namespace std;

int n, cost[10][10], visited[10];
int minCost = 999999;

void tsp(int city, int count, int totalCost) {
    if (count == n) {
        if (cost[city][0] != 0) {
            int finalCost = totalCost + cost[city][0];

            if (finalCost < minCost)
                minCost = finalCost;
        }
        return;
    }

    for (int i = 0; i < n; i++) {
        if (!visited[i] && cost[city][i] != 0) {
            visited[i] = 1;
            tsp(i, count + 1, totalCost + cost[city][i]);
            visited[i] = 0;
        }
    }
}

int main() {
    cin >> n;

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            cin >> cost[i][j];
        }
    }

    visited[0] = 1;

    tsp(0, 1, 0);

    if (minCost == 999999)
        cout << "No possible tour";
    else
        cout << "Minimum travelling cost = " << minCost;

    return 0;
}
